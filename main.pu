import os
import asyncio
import telebot
from metaapi_cloud_sdk import MetaApi

# 1. உங்களது டெலிகிராம் விவரங்கள்
BOT_TOKEN = "8872293287:AAFXZXmPD_TrS7m8E-bC68vjTyQfUawHEIU"
CHAT_ID = "1735087300"

# 2. உங்களது MetaApi டோக்கன் விவரங்கள்
# (கவனிக்க: MetaApi இணையதளத்தில் கணக்கு தொடங்கி இந்த இரண்டு விவரங்களையும் மட்டும் மாற்ற வேண்டும்)
METAAPI_TOKEN = "உங்கள்_METAAPI_TOKEN_இங்கே_போடவும்"
ACCOUNT_ID = "உங்கள்_METAAPI_ACCOUNT_ID_இங்கே_போடவும்"

bot = telebot.TeleBot(BOT_TOKEN)
api = MetaApi(METAAPI_TOKEN)

print("உண்மையான மார்க்கெட் பாட் இயங்குகிறது... சிக்னலுக்காகக் காத்திருக்கிறது!")

@bot.channel_post_handler(func=lambda message: True)
@bot.message_handler(func=lambda message: True)
def handle_signal(message):
    text = message.text.upper()
    
    # நீங்கள் டெலிகிராமில் அனுப்பும் சிக்னல் ஃபார்மட் (உதாரணம்: BUY EURUSD)
    if "BUY" in text or "SELL" in text:
        try:
            words = text.split()
            action = words[0]    # BUY அல்லது SELL
            symbol = words[1]    # EURUSD, BTCUSD போன்றவை
            
            # லூப் மூலம் Cloud வழியாக MT5-ஐ இணைக்கும் அசிங்க்ரோனஸ் செயல்பாடு
            async def place_order():
                account = await api.metatrader_account_api.get_account(ACCOUNT_ID)
                connection = account.get_rpc_connection()
                await connection.connect()
                
                # 0.01 லாட் அளவில் நிஜ மார்க்கெட்டில் ஆர்டர் போடுதல்
                if action == "BUY":
                    result = await connection.create_market_buy_order(symbol, 0.01)
                    bot.send_message(CHAT_ID, f"🟢 MT5 கணக்கில் வெற்றிகரமாக BUY செய்யப்பட்டது: {symbol}")
                elif action == "SELL":
                    result = await connection.create_market_sell_order(symbol, 0.01)
                    bot.send_message(CHAT_ID, f"🔴 MT5 கணக்கில் வெற்றிகரமாக SELL செய்யப்பட்டது: {symbol}")
            
            # இயங்குதளம் வழியாக ரன் செய்தல்
            asyncio.run(place_order())
            
        except Exception as e:
            bot.send_message(CHAT_ID, f"❌ ட்ரேடிங் செய்வதில் பிழை: {e}")

bot.infinity_polling()
